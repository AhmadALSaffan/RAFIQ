{
  "version": 1,
  "title": "Logo intro",
  "composition": { "width": 1920, "height": 1080, "fps": 60, "duration": 4.5, "background": "brand.surface", "safeArea": "youtube", "direction": "rtl" },
  "brand": "workspace",
  "assets": {},
  "layers": [
    {
      "id": "ring", "type": "shape", "shape": "circle", "start": 0, "end": 4.5, "fill": "transparent", "stroke": "brand.primary", "strokeWidth": 3,
      "layout": { "anchor": "center", "width": 34, "height": 34, "y": -8 },
      "animate": [ { "preset": "drawOn", "at": 0.2, "duration": 1.0, "ease": "inOut" }, { "preset": "fadeOut", "at": 4.0, "duration": 0.4 } ]
    },
    {
      "id": "mark", "type": "icon", "icon": "tabler:sparkles", "color": "brand.primary", "start": 0.9, "end": 4.5,
      "layout": { "anchor": "center", "width": 18, "height": 18, "y": -8 },
      "animate": [ { "preset": "scaleIn", "at": 0.9, "duration": 0.7, "ease": "spring" }, { "preset": "fadeOut", "at": 4.0, "duration": 0.4 } ]
    },
    {
      "id": "name", "type": "text", "text": "رفيق", "style": "display", "start": 1.4, "end": 4.5,
      "layout": { "below": "ring", "gap": 4 },
      "animate": [ { "preset": "fadeUp", "at": 1.4, "duration": 0.6 }, { "preset": "fadeOut", "at": 4.0, "duration": 0.4 } ]
    },
    {
      "id": "line", "type": "text", "text": "Your AI agent, on your desktop", "style": "title", "color": "brand.muted", "start": 1.9, "end": 4.5,
      "layout": { "below": "name", "gap": 2 },
      "animate": [ { "preset": "fadeIn", "at": 1.9, "duration": 0.6 }, { "preset": "fadeOut", "at": 4.0, "duration": 0.4 } ]
    }
  ],
  "audio": [
    { "id": "rise", "source": "sfx", "kind": "riser", "at": 0.1, "gain": -14 },
    { "id": "hit", "source": "sfx", "kind": "impact", "at": 0.9, "gain": -10 }
  ]
}
