{
  "name": "rafiq-desktop",
  "private": true,
  "version": "0.4.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:agent": "cd ../agent && .venv\\Scripts\\pyinstaller.exe rafiq-agent.spec --noconfirm --distpath dist --workpath build",
    "build:app": "node scripts/build-app.mjs",
    "release": "pnpm check && pnpm build:app && node scripts/release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b && eslint src && vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-kufi-arabic": "5.3.0",
    "@fontsource-variable/readex-pro": "5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/tajawal": "5.3.0",
    "@iconify-json/circle-flags": "1.2.12",
    "@iconify-json/fluent-emoji-flat": "1.2.6",
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/iconoir": "1.2.12",
    "@iconify-json/logos": "1.2.15",
    "@iconify-json/lucide": "1.2.141",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/ri": "1.2.10",
    "@tabler/icons": "3.49.0",
    "@tabler/icons-react": "^3.49.0",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lottie-web": "5.13.0",
    "mediabunny": "1.61.3",
    "motion": "^13.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-peeps": "0.1.10",
    "react-router-dom": "^7.1.1",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.2.4",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7",
    "vitest": "^5.0.0"
  }
